# notarize.env — secrets for ./notarize.sh
#
# Copy this file to `notarize.env` (no -example), fill in your values, then:
#   source notarize.env
#   ./notarize.sh
#
# `notarize.env` is gitignored. NEVER commit the filled-in copy.

# Your distribution Apple ID email (the one with the Developer ID Application cert).
export APPLE_ID="you@example.com"

# App-specific password generated at https://appleid.apple.com
# (Sign in → App-Specific Passwords → generate one labeled "notarytool").
# Format: xxxx-xxxx-xxxx-xxxx
export APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"

# Your Developer Program Team ID (10 chars, visible at
# https://developer.apple.com/account → Membership Details).
export TEAM_ID="XXXXXXXXXX"

# Exact "Developer ID Application" identity name as shown by:
#   security find-identity -v -p codesigning
# Format: "Developer ID Application: Your Name (XXXXXXXXXX)"
export SIGN_IDENTITY="Developer ID Application: Your Name (XXXXXXXXXX)"